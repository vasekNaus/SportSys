<!DOCTYPE html>
<html lang="cs-CZ">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportSys</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SportSys.Razor.styles.css" asp-append-version="true" />
    <script>
        // Aplikuj uložené téma co nejdříve, aby nedocházelo k blikání
        (function () {
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
            // Aplikuj uložené rozložení (wide/default)
            if (localStorage.getItem('layout') === 'wide') {
                document.documentElement.classList.add('layout-wide');
            }
        })();
    </script>
</head>
<body>
    <header>
        <a class="site-title" asp-area="" asp-page="/Index">
            <i class="fa-solid fa-hockey-puck fa-fw"></i> SportSys
        </a>
        <div class="header-actions">
            <partial name="_LoginPartial" />
            <button class="btn-layout-toggle" id="layoutToggle" aria-label="Přepnout celou šířku / standardní" title="Celá šířka / standardní">
                <i class="fa-solid fa-expand fa-fw"></i>
            </button>
            <button class="btn-theme-toggle" id="themeToggle" aria-label="Přepnout světlý/tmavý režim" title="Přepnout světlý/tmavý režim">
                <i class="fa-solid fa-circle-half-stroke"></i>
            </button>
        </div>
    </header>

    <nav>
        <input type="checkbox" id="nav-toggle" hidden />
        <label for="nav-toggle" aria-label="Otevřít navigaci">☰</label>
        <ul>
            <li><a asp-area="" asp-page="/Index"><i class="fa-solid fa-house fa-fw"></i> Úvod</a></li>
            <li>
                <a asp-area="sport" asp-page="/Training/Schedule/Index">
                    <i class="fa-solid fa-hockey-puck fa-fw"></i> Sport
                </a>
                <ul>
                    <li>
                        <a asp-area="sport" asp-page="/Training/Schedule/Index">
                            <i class="fa-solid fa-calendar-days fa-fw"></i> Rozpis
                        </a>
                    </li>
                    <li>
                        <a asp-area="sport" asp-page="/Training/Plan/Index">
                            <i class="fa-solid fa-calendar-week fa-fw"></i> Tréninkové plány
                        </a>
                    </li>
                    <li>
                        <a asp-area="sport" asp-page="/Training/Requirement/Index">
                            <i class="fa-solid fa-list-check fa-fw"></i> Požadavky
                        </a>
                    </li>
                    <li>
                        <a asp-area="sport" asp-page="/IceRink/Index">
                            <i class="fa-solid fa-warehouse fa-fw"></i> Zimní stadiony
                        </a>
                    </li>
                    <li>
                        <a asp-area="sport" asp-page="/Team/Index">
                            <i class="fa-solid fa-people-group fa-fw"></i> Týmy
                        </a>
                    </li>
                    <li>
                        <a asp-area="sport" asp-page="/Season/Index">
                            <i class="fa-solid fa-calendar fa-fw"></i> Sezóny
                        </a>
                    </li>
                    <li>
                        <a asp-area="sport" asp-page="/SeasonCategory/Index">
                            <i class="fa-solid fa-layer-group fa-fw"></i> Kategorie sezón
                        </a>
                    </li>
                </ul>
            </li>
            <li>
                <a asp-area="Inventory" asp-page="/Manufacturers/Index">
                    <i class="fa-solid fa-box-open fa-fw"></i> Sklad
                </a>
                <ul>
                    <li>
                        <a asp-area="Inventory" asp-page="/Items/Index">
                            <i class="fa-solid fa-shirt fa-fw"></i> Položky
                        </a>
                    </li>
                    <li>
                        <a asp-area="Inventory" asp-page="/Manufacturers/Index">
                            <i class="fa-solid fa-industry fa-fw"></i> Výrobci
                        </a>
                    </li>
                    <li>
                        <a asp-area="Inventory" asp-page="/Locations/Index">
                            <i class="fa-solid fa-location-dot fa-fw"></i> Umístění
                        </a>
                    </li>
                    <li>
                        <a asp-area="Inventory" asp-page="/Categories/Index">
                            <i class="fa-solid fa-tags fa-fw"></i> Kategorie
                        </a>
                    </li>
                    <li>
                        <a asp-area="Inventory" asp-page="/Loans/Index">
                            <i class="fa-solid fa-hand-holding-box fa-fw"></i> Výpůjčky
                        </a>
                    </li>
                </ul>
            </li>
            <li>
                <a asp-area="hr" asp-page="/Coach/Index">
                    <i class="fa-solid fa-user-tie fa-fw"></i> Personalistika
                </a>
                <ul>
                    <li>
                        <a asp-area="hr" asp-page="/Coach/Index">
                            <i class="fa-solid fa-people-group fa-fw"></i> Trenéři
                        </a>
                    </li>
                    <li>
                        <a asp-area="hr" asp-page="/Attendance/Index">
                            <i class="fa-solid fa-file-excel fa-fw"></i> Docházka
                        </a>
                    </li>
                </ul>
            </li>
            <li><a asp-area="" asp-page="/Privacy"><i class="fa-solid fa-shield fa-fw"></i> Ochrana soukromí</a></li>
        </ul>
    </nav>

    <main>
        @if (ViewData["Title"] is string title && !string.IsNullOrEmpty(title))
        {
            <h1>@title</h1>
        }
        @RenderBody()
    </main>

    <footer>
        &copy; @DateTime.Now.Year SportSys &mdash; <a asp-area="" asp-page="/Privacy">Ochrana soukromí</a>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @* <script src="https://cdnjs.cloudflare.com/ajax/libs/aspnet-client-validation/0.11.0/aspnet-client-validation.min.js"></script> *@
   @*  <script>
        new aspnetValidation.ValidationService().bootstrap();
    </script> *@

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
