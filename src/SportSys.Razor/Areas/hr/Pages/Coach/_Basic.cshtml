@model SportSys.Razor.Areas.hr.Pages.Coach.EditModel

<form method="post" asp-page-handler="SaveBasic">
    <input type="hidden" asp-for="BasicInput.CoachId" />

    @if (Model.IsNew)
    {
        <p>
            <label asp-for="BasicInput.UserId"></label>
            <select asp-for="BasicInput.UserId" asp-items="Model.UserSelectList"></select>
            <span asp-validation-for="BasicInput.UserId" class="field-validation-error"></span>
        </p>
    }
    else
    {
        <input type="hidden" asp-for="BasicInput.UserId" />
        <p>
            <label>Uživatel</label>
            <strong>@Model.BasicInput.UserName</strong>
            <span class="description">Propojeného uživatele nelze po vytvoření změnit.</span>
        </p>
    }

    <p>
        <label asp-for="BasicInput.DisplayName"></label>
        <input asp-for="BasicInput.DisplayName" />
        <span asp-validation-for="BasicInput.DisplayName" class="field-validation-error"></span>
    </p>
    <p>
        <label asp-for="BasicInput.Email"></label>
        <input asp-for="BasicInput.Email" type="email" />
        <span asp-validation-for="BasicInput.Email" class="field-validation-error"></span>
    </p>
    <p>
        <label asp-for="BasicInput.PhoneNumber"></label>
        <input asp-for="BasicInput.PhoneNumber" type="tel" />
        <span asp-validation-for="BasicInput.PhoneNumber" class="field-validation-error"></span>
    </p>
    <p>
        <label asp-for="BasicInput.PersonalNumber"></label>
        <input asp-for="BasicInput.PersonalNumber" />
        <span asp-validation-for="BasicInput.PersonalNumber" class="field-validation-error"></span>
    </p>
    <p>
        <label asp-for="BasicInput.BirthNumber"></label>
        <input asp-for="BasicInput.BirthNumber" autocomplete="off" />
        <span asp-validation-for="BasicInput.BirthNumber" class="field-validation-error"></span>
    </p>

    <footer>
        <button type="submit" class="button">
            <i class="fa-solid fa-floppy-disk fa-fw"></i> Uložit základní údaje
        </button>
        <a class="button secondary" asp-page="Index">
            <i class="fa-solid fa-arrow-left fa-fw"></i> Zpět na seznam
        </a>
    </footer>
</form>

@if (!Model.IsNew)
{
    var photoUrl = Model.Coach.HasPhoto
        ? Url.Page("Edit", "Photo", new { id = Model.Coach.CoachId, v = DateTime.UtcNow.Ticks })
        : Url.Content("~/images/default-avatar.svg");

    <div class="coach-photo-editor">
        <img class="coach-avatar large" src="@photoUrl" alt="Fotografie trenéra @Model.Coach.DisplayName" />
        <div class="coach-photo-actions">
            <form method="post" enctype="multipart/form-data" asp-page-handler="SavePhoto">
                <input type="hidden" name="id" value="@Model.Coach.CoachId" />
                <p>
                    <label asp-for="Photo">Fotografie</label>
                    <input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" />
                    <span class="description">JPEG, PNG nebo WebP, maximálně 5 MB.</span>
                    <span asp-validation-for="Photo" class="field-validation-error"></span>
                </p>
                <button type="submit" class="button secondary">
                    <i class="fa-solid fa-camera fa-fw"></i> Nahrát fotografii
                </button>
            </form>

            @if (Model.Coach.HasPhoto)
            {
                <form method="post" asp-page-handler="DeletePhoto">
                    <input type="hidden" name="id" value="@Model.Coach.CoachId" />
                    <button type="submit" class="button tertiary" onclick="return confirm('Opravdu chcete fotografii odstranit?')">
                        <i class="fa-solid fa-trash fa-fw"></i> Odstranit fotografii
                    </button>
                </form>
            }
        </div>
    </div>
}
