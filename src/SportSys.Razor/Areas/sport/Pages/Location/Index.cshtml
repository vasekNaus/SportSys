@page
@model IndexModel
@{
    ViewData["Title"] = "Lokality";
}

@if (Model.StatusMessage is not null)
{
    <div class="infobox">
        <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
    </div>
}

<form method="get" class="filter-form">
    <div class="filter-row">
        <div class="field">
            <label asp-for="Search">Název nebo město</label>
            <input asp-for="Search" type="search" placeholder="Hledat lokalitu…" />
        </div>
        <div class="field">
            <label asp-for="IsActive">Stav</label>
            <select asp-for="IsActive">
                <option value="true">Aktivní</option>
                <option value="false">Neaktivní</option>
                <option value="">Vše</option>
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="button">
                <i class="fa-solid fa-magnifying-glass fa-fw"></i> Hledat
            </button>
            <a class="button secondary" asp-page="Index">
                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtr
            </a>
        </div>
    </div>
</form>

<p>
    <a class="button" asp-page="Edit">
        <i class="fa-solid fa-plus fa-fw"></i> Přidat lokalitu
    </a>
</p>

@if (Model.Locations.Count == 0)
{
    <p class="text-muted">Žádné lokality nejsou zadány.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Název</th>
                <th>Ulice</th>
                <th>Město</th>
                <th>PSČ</th>
                <th>Stav</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in Model.Locations)
            {
                <tr class="@(!location.IsActive ? "inactive-row" : null)">
                    <td>@location.Name</td>
                    <td>@location.Street</td>
                    <td>@location.City</td>
                    <td>@location.ZipCode</td>
                    <td>@(location.IsActive ? "Aktivní" : "Neaktivní")</td>
                    <td class="buttons">
                        <a class="button secondary icon-btn" asp-page="Edit" asp-route-id="@location.Id"
                           title="Upravit">
                            <i class="fa-solid fa-pen fa-fw"></i>
                        </a>
                        <form method="post"
                              asp-page-handler="SetActive"
                              asp-route-id="@location.Id"
                              asp-route-isActive="@(!location.IsActive)"
                              asp-route-search="@Model.Search"
                              style="display:inline">
                            <button type="submit"
                                    class="button tertiary icon-btn"
                                    title="@(location.IsActive ? "Zneaktivnit" : "Aktivovat")"
                                    onclick="@(location.IsActive ? "return confirm('Opravdu chcete lokalitu zneaktivnit?')" : null)">
                                <i class="fa-solid @(location.IsActive ? "fa-trash" : "fa-rotate-left") fa-fw"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
