@page
@model IndexModel
@{
    ViewData["Title"] = "Kategorie sezón";
}

@if (Model.StatusMessage is not null)
{
    <div class="infobox">
        <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
    </div>
}

<form method="get" class="filter-form">
    <div class="filter-row">
        <div class="field">
            <label asp-for="Search">Kategorie, soutěž nebo sezóna</label>
            <input asp-for="Search" type="search" placeholder="Hledat kategorii…" />
        </div>
        <div class="field">
            <label asp-for="IsActive">Stav</label>
            <select asp-for="IsActive">
                <option value="true">Aktivní</option>
                <option value="false">Neaktivní</option>
                <option value="">Vše</option>
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="button">
                <i class="fa-solid fa-magnifying-glass fa-fw"></i> Hledat
            </button>
            <a class="button secondary" asp-page="Index">
                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtr
            </a>
        </div>
    </div>
</form>

<p>
    <a class="button" asp-page="Edit">
        <i class="fa-solid fa-plus fa-fw"></i> Přidat kategorii
    </a>
</p>

@if (Model.Categories.Count == 0)
{
    <p class="text-muted">Žádné kategorie sezón neodpovídají filtru.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Sezóna</th>
                <th>Kategorie</th>
                <th>Pořadí</th>
                <th>Kód soutěže</th>
                <th>Tým v soutěži</th>
                <th>Stav</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr class="@(!category.IsActive ? "inactive-row" : null)">
                    <td>@category.SeasonName</td>
                    <td>@category.Code</td>
                    <td>@category.Order</td>
                    <td>@category.CompetitionCode</td>
                    <td>@category.CompetitionTeamName</td>
                    <td>@(category.IsActive ? "Aktivní" : "Neaktivní")</td>
                    <td class="buttons">
                        <a class="button secondary icon-btn"
                           asp-page="Edit"
                           asp-route-seasonId="@category.SeasonId"
                           asp-route-code="@category.Code"
                           title="Upravit">
                            <i class="fa-solid fa-pen fa-fw"></i>
                        </a>
                        <form method="post"
                              asp-page-handler="SetActive"
                              asp-route-seasonId="@category.SeasonId"
                              asp-route-code="@category.Code"
                              asp-route-isActive="@(!category.IsActive)"
                              asp-route-search="@Model.Search"
                              style="display:inline">
                            <button type="submit"
                                    class="button tertiary icon-btn"
                                    title="@(category.IsActive ? "Zneaktivnit" : "Aktivovat")"
                                    onclick="@(category.IsActive ? "return confirm('Opravdu chcete kategorii sezóny zneaktivnit?')" : null)">
                                <i class="fa-solid @(category.IsActive ? "fa-trash" : "fa-rotate-left") fa-fw"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
