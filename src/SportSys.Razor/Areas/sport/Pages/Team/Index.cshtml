@page
@model IndexModel
@{
    ViewData["Title"] = "Týmy";
}

@if (Model.StatusMessage is not null)
{
    <div class="infobox">
        <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
    </div>
}

<form method="get" class="filter-form">
    <div class="filter-row">
        <div class="field">
            <label asp-for="Search">Kód, název nebo město</label>
            <input asp-for="Search" type="search" placeholder="Hledat tým…" />
        </div>
        <div class="field">
            <label asp-for="IsActive">Stav</label>
            <select asp-for="IsActive">
                <option value="true">Aktivní</option>
                <option value="false">Neaktivní</option>
                <option value="">Vše</option>
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="button">
                <i class="fa-solid fa-magnifying-glass fa-fw"></i> Hledat
            </button>
            <a class="button secondary" asp-page="Index">
                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtr
            </a>
        </div>
    </div>
</form>

<p>
    <a class="button" asp-page="Edit">
        <i class="fa-solid fa-plus fa-fw"></i> Přidat tým
    </a>
</p>

@if (Model.Teams.Count == 0)
{
    <p class="text-muted">Žádné týmy neodpovídají filtru.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Kód</th>
                <th>Název</th>
                <th>Město</th>
                <th>Domácí lokalita</th>
                <th>Stav</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var team in Model.Teams)
            {
                <tr class="@(!team.IsActive ? "inactive-row" : null)">
                    <td>@team.Code</td>
                    <td>@team.Name</td>
                    <td>@team.City</td>
                    <td>@team.HomeLocationName</td>
                    <td>@(team.IsActive ? "Aktivní" : "Neaktivní")</td>
                    <td class="buttons">
                        <a class="button secondary icon-btn"
                           asp-page="Edit"
                           asp-route-id="@team.Id"
                           title="Upravit">
                            <i class="fa-solid fa-pen fa-fw"></i>
                        </a>
                        <form method="post"
                              asp-page-handler="SetActive"
                              asp-route-id="@team.Id"
                              asp-route-isActive="@(!team.IsActive)"
                              asp-route-search="@Model.Search"
                              style="display:inline">
                            <button type="submit"
                                    class="button tertiary icon-btn"
                                    title="@(team.IsActive ? "Zneaktivnit" : "Aktivovat")"
                                    onclick="@(team.IsActive ? "return confirm('Opravdu chcete tým zneaktivnit?')" : null)">
                                <i class="fa-solid @(team.IsActive ? "fa-trash" : "fa-rotate-left") fa-fw"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
