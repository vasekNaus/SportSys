@page
@model EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nový tým" : "Upravit tým";
}

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<form method="post">
    @Html.EditorFor(
        m => m.Input,
        new { HomeLocationIdItems = Model.HomeLocationIdItems })

    <footer>
        <button type="submit" class="button">
            <i class="fa-solid fa-floppy-disk fa-fw"></i> Uložit
        </button>
        <a class="button secondary" asp-page="Index">
            <i class="fa-solid fa-xmark fa-fw"></i> Zrušit
        </a>
        @if (!Model.IsNew)
        {
            <button type="submit"
                    asp-page-handler="SetActive"
                    name="isActive"
                    value="@(!Model.Input.IsActive)"
                    class="button tertiary"
                    onclick="@(Model.Input.IsActive ? "return confirm('Opravdu chcete tým zneaktivnit?')" : null)">
                <i class="fa-solid @(Model.Input.IsActive ? "fa-trash" : "fa-rotate-left") fa-fw"></i>
                @(Model.Input.IsActive ? "Zneaktivnit" : "Aktivovat")
            </button>
        }
    </footer>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
