@page
@model IndexModel
@{
    ViewData["Title"] = "Požadavky";
    var trainingCoachViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
    {
        ["IncludeHours"] = true,
    };
    var trainingCoachColumns = new[]
    {
        (Code: "H", Header: "Hlavní"),
        (Code: "A", Header: "Asistent"),
        (Code: "B", Header: "Brankáři"),
        (Code: "O", Header: "Obránci"),
    };

    var selectedTrainingTypeNames = Model.TrainingTypes
        .Where(type => Model.SelectedTrainingTypeIds.Contains(type.Id))
        .Select(type => type.Name)
        .ToList();
    var trainingTypeSummary = selectedTrainingTypeNames.Count switch
    {
        0 => "Všechny typy",
        1 => selectedTrainingTypeNames[0],
        _ => $"Vybráno: {selectedTrainingTypeNames.Count}",
    };

    var selectedTrainingPhaseNames = Model.TrainingPhases
        .Where(phase => Model.SelectedTrainingPhaseIds.Contains(phase.Id))
        .Select(phase => phase.Name)
        .ToList();
    var trainingPhaseSummary = selectedTrainingPhaseNames.Count switch
    {
        0 => "Všechny fáze",
        1 => selectedTrainingPhaseNames[0],
        _ => $"Vybráno: {selectedTrainingPhaseNames.Count}",
    };
}

<form method="get" class="schedule-filter">
    <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
    <fieldset class="schedule-filter-categories">
        <legend>Zobrazit</legend>
        <div class="schedule-filter-checkboxes">
            <label class="checkbox-label">
                <input type="checkbox" id="ShowTrainings" name="ShowTrainings" value="true" checked="@Model.ShowTrainings" />
                <input type="hidden" name="ShowTrainings" value="false" />
                Tréninky
            </label>
            <label class="checkbox-label">
                <input type="checkbox" id="ShowMatches" name="ShowMatches" value="true" checked="@Model.ShowMatches" />
                <input type="hidden" name="ShowMatches" value="false" />
                Zápasy
            </label>
        </div>
    </fieldset>

    <section class="schedule-filter-panel schedule-filter-panel--common">
        <h2 class="schedule-filter-panel-title">Společné filtry</h2>

        <div class="schedule-filter-row">
            <div class="field">
                <label for="SeasonId">Sezóna</label>
                <select id="SeasonId"
                        name="SeasonId"
                        class="textbox"
                        onchange="this.form.submit()">
                    <option value="">— vyberte sezónu —</option>
                    @foreach (var season in Model.Seasons)
                    {
                        <option value="@season.Id" selected="@(Model.SeasonId == season.Id)">
                            @season.Name
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label asp-for="SelectedCoachIds">Trenéři</label>
                <search-multiselect asp-for="SelectedCoachIds"
                                    asp-items="Model.CoachSelectList"
                                    placeholder="Hledat trenéra" />
            </div>

            <div class="field">
                <span class="schedule-filter-label" id="TrainingPhaseLabel">Fáze <small class="text-muted">(jen tréninky)</small></span>
                <details class="schedule-multiselect"
                         data-multiselect
                         data-empty-label="Všechny fáze">
                    <summary aria-labelledby="TrainingPhaseLabel">
                        <span data-multiselect-summary>@trainingPhaseSummary</span>
                    </summary>
                    <div class="schedule-multiselect-menu">
                        <div class="schedule-multiselect-options">
                            @foreach (var phase in Model.TrainingPhases)
                            {
                                <label class="schedule-multiselect-option">
                                    <input type="checkbox"
                                           name="SelectedTrainingPhaseIds"
                                           value="@phase.Id"
                                           checked="@Model.SelectedTrainingPhaseIds.Contains(phase.Id)" />
                                    <span data-multiselect-option-label>@phase.Name</span>
                                </label>
                            }
                        </div>
                        <button type="button"
                                class="schedule-multiselect-clear"
                                data-multiselect-clear
                                hidden>
                            <i class="fa-solid fa-filter-circle-xmark fa-fw"></i>
                            Vymazat výběr
                        </button>
                    </div>
                </details>
            </div>

            <div class="field">
                <label for="ValidOn">Datum</label>
                @Html.EditorFor(m => m.ValidOn, "Date", new { InputCssClass = "textbox" })
                <span asp-validation-for="ValidOn" class="field-validation-error"></span>
            </div>
        </div>

        @if (Model.SeasonCategories.Count > 0)
        {
            <fieldset class="schedule-filter-categories">
                <legend>Kategorie</legend>
                <div class="schedule-filter-checkboxes">
                    @foreach (var category in Model.SeasonCategories)
                    {
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   name="SelectedCategoryCodes"
                                   value="@category.Code"
                                   checked="@Model.SelectedCategoryCodes.Contains(category.Code)" />
                            @category.Code
                        </label>
                    }
                </div>
            </fieldset>
        }
        else if (Model.SeasonId.HasValue)
        {
            <p class="text-muted">Pro zvolenou sezónu nejsou definovány žádné aktivní kategorie.</p>
        }
    </section>

    @if (Model.ShowTrainings)
    {
        <section class="schedule-filter-panel schedule-filter-panel--trainings">
            <h2 class="schedule-filter-panel-title">Tréninky</h2>

            <div class="schedule-filter-row">
                <div class="field">
                    <span class="schedule-filter-label" id="TrainingTypeLabel">Typ tréninku</span>
                    <details class="schedule-multiselect"
                             data-multiselect
                             data-empty-label="Všechny typy">
                        <summary aria-labelledby="TrainingTypeLabel">
                            <span data-multiselect-summary>@trainingTypeSummary</span>
                        </summary>
                        <div class="schedule-multiselect-menu">
                            <div class="schedule-multiselect-options">
                                @foreach (var type in Model.TrainingTypes)
                                {
                                    <label class="schedule-multiselect-option">
                                        <input type="checkbox"
                                               name="SelectedTrainingTypeIds"
                                               value="@type.Id"
                                               checked="@Model.SelectedTrainingTypeIds.Contains(type.Id)" />
                                        <span data-multiselect-option-label>@type.Name</span>
                                    </label>
                                }
                            </div>
                            <button type="button"
                                    class="schedule-multiselect-clear"
                                    data-multiselect-clear
                                    hidden>
                                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i>
                                Vymazat výběr
                            </button>
                        </div>
                    </details>
                </div>
            </div>
        </section>
    }

    @if (Model.ShowMatches)
    {
        <section class="schedule-filter-panel schedule-filter-panel--matches">
            <h2 class="schedule-filter-panel-title">Zápasy</h2>
            <p class="text-muted">Pro zápasy zatím nejsou k dispozici další filtry.</p>
        </section>
    }

    @if (Model.SeasonId.HasValue)
    {
        <div class="schedule-filter-actions">
            <button type="submit" class="button">
                <i class="fa-solid fa-list-check fa-fw"></i> Zobrazit
            </button>
            <a class="button secondary" asp-page="./Index">
                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtr
            </a>
        </div>
    }
</form>

@if (Model.ExportErrorMessage is not null)
{
    <p class="text-danger">@Model.ExportErrorMessage</p>
}

@if (Model.Seasons.Count == 0)
{
    <p class="text-muted">Neexistuje žádná aktivní sezóna.</p>
}
else
{
    @if (Model.ShowTrainings)
    {
        <h2>Požadavky na tréninky</h2>

        @if (Model.Requirements.Count == 0)
        {
            <p class="text-muted">Žádné požadavky na tréninky neodpovídají filtru.</p>
        }
        else
        {
            <form method="get" asp-page="./Index" class="schedule-filter-actions">
                <input type="hidden" name="handler" value="ExportRequirements" />
                <input type="hidden" name="SeasonId" value="@Model.SeasonId" />
                @foreach (var code in Model.SelectedCategoryCodes)
                {
                    <input type="hidden" name="SelectedCategoryCodes" value="@code" />
                }
                @foreach (var id in Model.SelectedTrainingTypeIds)
                {
                    <input type="hidden" name="SelectedTrainingTypeIds" value="@id" />
                }
                @foreach (var id in Model.SelectedTrainingPhaseIds)
                {
                    <input type="hidden" name="SelectedTrainingPhaseIds" value="@id" />
                }
                @foreach (var id in Model.SelectedCoachIds)
                {
                    <input type="hidden" name="SelectedCoachIds" value="@id" />
                }
                <input type="hidden" name="ValidOn" value="@Model.ValidOn?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="ShowTrainings" value="@Model.ShowTrainings.ToString().ToLowerInvariant()" />
                <input type="hidden" name="ShowMatches" value="@Model.ShowMatches.ToString().ToLowerInvariant()" />
                <button type="submit" class="button secondary">Excel</button>
            </form>

            <table class="grid">
                <thead>
                    <tr>
                        <th class="c">Sezóna</th>
                        <th class="c">Kategorie</th>
                        <th class="c">Typ tréninku</th>
                        <th class="c">Fáze</th>
                        <th class="c">Od</th>
                        <th class="c">Do</th>
                        <th class="c">Rozsah [h]</th>
                        @foreach (var role in trainingCoachColumns)
                        {
                            <th class="c">@role.Header</th>
                        }
                        <th class="c">Trenéři</th>
                        <th class="c">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var requirement in Model.Requirements)
                    {
                        var otherRoleAssignments = SportSys.Razor.Models.RequirementCoachGroups.OtherRoles(requirement.CoachAssignments);
                        <tr>
                            <td class="c">@requirement.SeasonName</td>
                            <td>@requirement.SeasonCategoryName</td>
                            <td>@requirement.TrainingTypeName</td>
                            <td class="c">@requirement.TrainingPhaseName</td>
                            <td class="c">@requirement.From.ToString("dd.MM.yyyy")</td>
                            <td class="c">@requirement.To.ToString("dd.MM.yyyy")</td>
                            <td class="r">@requirement.DurationHours.ToString("0.##")</td>
                            @foreach (var role in trainingCoachColumns)
                            {
                                var coachTexts = SportSys.Razor.Models.RequirementCoachGroups.ForRole(requirement.CoachAssignments, role.Code);
                                <td>@(coachTexts.Count == 0 ? "-" : string.Join(", ", coachTexts))</td>
                            }
                            <td><partial name="_CoachGroups" model="otherRoleAssignments" view-data="trainingCoachViewData" /></td>
                            <td class="buttons c">
                                <a class="button secondary icon-btn"
                                   asp-page="./EditTraining"
                                   asp-route-id="@requirement.Id"
                                   title="Upravit">
                                    <i class="fa-solid fa-pen fa-fw"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (Model.ShowMatches)
    {
        <h2>Požadavky na zápasy</h2>

        @if (Model.MatchRequirements.Count == 0)
        {
            <p class="text-muted">Žádné požadavky na zápasy neodpovídají filtru.</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th>Sezóna</th>
                        <th>Kategorie</th>
                        <th>Platnost od</th>
                        <th>Platnost do</th>
                        <th>Počet zápasů</th>
                        <th>Trenéři</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var requirement in Model.MatchRequirements)
                    {
                        <tr>
                            <td>@requirement.SeasonName</td>
                            <td>@requirement.SeasonCategoryCode</td>
                            <td>@requirement.From.ToString("dd.MM.yyyy")</td>
                            <td>@requirement.To.ToString("dd.MM.yyyy")</td>
                            <td>@requirement.MatchCount</td>
                            <td>
                                <partial name="_CoachGroups" model="requirement.CoachAssignments" />
                            </td>
                            <td class="buttons">
                                <a class="button secondary icon-btn"
                                   asp-page="./EditMatch"
                                   asp-route-id="@requirement.Id"
                                   title="Upravit">
                                    <i class="fa-solid fa-pen fa-fw"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (Model.ShowTrainings)
    {
        @if (Model.CoverageRows.Count > 0)
        {
            <form method="get" asp-page="./Index" class="schedule-filter-actions">
                <input type="hidden" name="handler" value="ExportCoverage" />
                <input type="hidden" name="SeasonId" value="@Model.SeasonId" />
                @foreach (var code in Model.SelectedCategoryCodes)
                {
                    <input type="hidden" name="SelectedCategoryCodes" value="@code" />
                }
                @foreach (var id in Model.SelectedTrainingTypeIds)
                {
                    <input type="hidden" name="SelectedTrainingTypeIds" value="@id" />
                }
                @foreach (var id in Model.SelectedTrainingPhaseIds)
                {
                    <input type="hidden" name="SelectedTrainingPhaseIds" value="@id" />
                }
                @foreach (var id in Model.SelectedCoachIds)
                {
                    <input type="hidden" name="SelectedCoachIds" value="@id" />
                }
                <input type="hidden" name="ValidOn" value="@Model.ValidOn?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="ShowTrainings" value="@Model.ShowTrainings.ToString().ToLowerInvariant()" />
                <input type="hidden" name="ShowMatches" value="@Model.ShowMatches.ToString().ToLowerInvariant()" />
                <button type="submit" class="button secondary">Excel</button>
            </form>
        }

        @await Component.InvokeAsync(
            "TrainingRequirementCoverage",
            new
            {
                requirements = Model.CoverageRequirements,
                plans = Model.CoveragePlans,
                selectedCoachIds = Model.SelectedCoachIds,
            })
    }
}
