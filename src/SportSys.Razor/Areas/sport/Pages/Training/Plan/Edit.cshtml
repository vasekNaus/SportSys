@page
@model EditModel
@{
  ViewData["Title"] = "Upravit tréninkový plán";
  var formAction = Url.Page("./Edit", new { id = Model.Input.Id, handler = "" });
  var categories = string.Join(" + ", Model.Context.CategoryCodes);
  var trainingTypes = string.Join(
      ", ",
      Model.Context.Members
          .Select(member => member.TrainingTypeName)
          .Distinct(StringComparer.CurrentCulture)
          .OrderBy(name => name, StringComparer.CurrentCulture));
}

@if (Model.StatusMessage is not null)
{
  <div class="infobox">
    <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
  </div>
}

<dl class="training-edit-summary">
  <div>
    <dt>Kategorie</dt>
    <dd>@categories</dd>
  </div>
  <div>
    <dt>Typ tréninku</dt>
    <dd>@trainingTypes</dd>
  </div>
</dl>

@if (Model.Context.IsGrouped)
{
  @if (Model.Context.CanEdit)
  {
    <div class="infobox">
      <i class="fa-solid fa-link fa-fw"></i>
      Změny budou uloženy pro všechny spojené tréninkové plány:
      @string.Join(", ", Model.Context.CategoryCodes).
    </div>
  }
  else
  {
    <div class="validation-summary-errors" role="alert">
      <i class="fa-solid fa-triangle-exclamation fa-fw"></i>
      Spojené tréninkové plány nemají stejnou platnost, den, čas nebo lokalitu.
      Dokud nebudou hodnoty sjednocené, nelze skupinu editovat.
    </div>
  }
}

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

@if (Model.Context.CanEdit)
{
  <form method="post" asp-antiforgery="true" action="@formAction">
    @if (Model.Context.IsGrouped)
    {
      <div class="training-edit-members">
        @for (var i = 0; i < Model.Context.Members.Count; i++)
        {
          var member = Model.Context.Members[i];
          <section aria-labelledby="member-coaches-@member.Id">
            <h3 id="member-coaches-@member.Id">@member.SeasonCategoryCode</h3>
            <input type="hidden"
                   name="Input.MemberCoachAssignments[@i].TrainingPlanId"
                   value="@member.Id" />
            <table class="details">
              <thead>
                <tr>
                  <th scope="col">Trenér</th>
                  <th scope="col">Role</th>
                  <th scope="col">Akce</th>
                </tr>
              </thead>
              <tbody>
                @for (var j = 0; j < Model.Input.MemberCoachAssignments[i].CoachAssignments.Count; j++)
                {
                  var assignment = Model.Input.MemberCoachAssignments[i].CoachAssignments[j];
                  <tr>
                    <td>
                      <select name="Input.MemberCoachAssignments[@i].CoachAssignments[@j].CoachId"
                              aria-label="Trenér"
                              required>
                        <option value="">— vyberte trenéra —</option>
                        @foreach (var coach in Model.Context.AvailableCoaches)
                        {
                          <option value="@coach.Id" selected="@(assignment.CoachId == coach.Id)">
                            @coach.DisplayName
                          </option>
                        }
                      </select>
                    </td>
                    <td>
                      <select name="Input.MemberCoachAssignments[@i].CoachAssignments[@j].CoachRoleId"
                              aria-label="Role"
                              required>
                        <option value="">— vyberte roli —</option>
                        @foreach (var role in Model.Context.CoachRoles)
                        {
                          <option value="@role.Id" selected="@(assignment.CoachRoleId == role.Id)">
                            @role.Name
                          </option>
                        }
                      </select>
                    </td>
                    <td class="buttons">
                      <button type="submit"
                              class="button tertiary icon-btn"
                              formnovalidate
                              asp-page-handler="RemoveCoach"
                              name="memberIndex"
                              value="@i"
                              asp-route-assignmentIndex="@j"
                              title="Odebrat trenéra">
                        <i class="fa-solid fa-trash fa-fw"></i>
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
            <button type="submit"
                    class="button secondary"
                    formnovalidate
                    asp-page-handler="AddCoach"
                    name="memberIndex"
                    value="@i">
              <i class="fa-solid fa-plus fa-fw"></i> Přidat trenéra
            </button>
          </section>
        }
      </div>
    }

    @Html.EditorFor(
        model => model.Input,
        new { DayNameItems = Model.DayNameItems, LocationIdItems = Model.LocationIdItems })

    @if (!Model.Context.IsGrouped)
    {
      <section aria-labelledby="coach-assignments-heading">
        <h2 id="coach-assignments-heading">Trenéři</h2>
        <table class="details">
          <thead>
            <tr>
              <th scope="col">Trenér</th>
              <th scope="col">Role</th>
              <th scope="col">Akce</th>
            </tr>
          </thead>
          <tbody>
            @for (var i = 0; i < Model.Input.CoachAssignments.Count; i++)
            {
              var assignment = Model.Input.CoachAssignments[i];
              <tr>
                <td>
                  <select name="Input.CoachAssignments[@i].CoachId"
                          aria-label="Trenér"
                          required>
                    <option value="">— vyberte trenéra —</option>
                    @foreach (var coach in Model.Context.AvailableCoaches)
                    {
                      <option value="@coach.Id" selected="@(assignment.CoachId == coach.Id)">
                        @coach.DisplayName
                      </option>
                    }
                  </select>
                </td>
                <td>
                  <select name="Input.CoachAssignments[@i].CoachRoleId"
                          aria-label="Role"
                          required>
                    <option value="">— vyberte roli —</option>
                    @foreach (var role in Model.Context.CoachRoles)
                    {
                      <option value="@role.Id" selected="@(assignment.CoachRoleId == role.Id)">
                        @role.Name
                      </option>
                    }
                  </select>
                </td>
                <td class="buttons">
                  <button type="submit"
                          class="button tertiary icon-btn"
                          formnovalidate
                          asp-page-handler="RemoveCoach"
                          name="assignmentIndex"
                          value="@i"
                          title="Odebrat trenéra">
                    <i class="fa-solid fa-trash fa-fw"></i>
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
        <button type="submit"
                class="button secondary"
                formnovalidate
                asp-page-handler="AddCoach">
          <i class="fa-solid fa-plus fa-fw"></i> Přidat trenéra
        </button>
      </section>
    }

    <footer>
      <button type="submit" class="button">
        <i class="fa-solid fa-floppy-disk fa-fw"></i> Uložit
      </button>
      <button type="button" class="button secondary" onclick="closeTrainingPlanEdit()">
        <i class="fa-solid fa-xmark fa-fw"></i> Zavřít
      </button>
    </footer>
  </form>
}
else
{
  <p class="buttons">
    <button type="button" class="button secondary" onclick="closeTrainingPlanEdit()">
      <i class="fa-solid fa-xmark fa-fw"></i> Zavřít
    </button>
  </p>
}

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    function closeTrainingPlanEdit() {
      window.close();
      window.setTimeout(function () {
        if (!window.closed) {
          window.location.href = '@Url.Page("./Index")';
        }
      }, 100);
    }
  </script>
}
