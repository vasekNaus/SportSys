@page
@model EditModel
@{
    ViewData["Title"] = "Upravit tréninkový plán";
    var categories = string.Join(" + ", Model.Context.CategoryNames);
    var trainingTypes = string.Join(
        ", ",
        Model.Context.Members
            .Select(member => member.TrainingTypeName)
            .Distinct(StringComparer.CurrentCulture)
            .OrderBy(name => name, StringComparer.CurrentCulture));
}

@if (Model.StatusMessage is not null)
{
    <div class="infobox">
        <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
    </div>
}

<dl class="training-edit-summary">
    <div>
        <dt>Kategorie</dt>
        <dd>@categories</dd>
    </div>
    <div>
        <dt>Typ tréninku</dt>
        <dd>@trainingTypes</dd>
    </div>
</dl>

@if (Model.Context.IsGrouped)
{
    @if (Model.Context.CanEdit)
    {
        <div class="infobox">
            <i class="fa-solid fa-link fa-fw"></i>
            Změny budou uloženy pro všechny spojené tréninkové plány:
            @string.Join(", ", Model.Context.CategoryNames).
        </div>
    }
    else
    {
        <div class="validation-summary-errors" role="alert">
            <i class="fa-solid fa-triangle-exclamation fa-fw"></i>
            Spojené tréninkové plány nemají stejnou platnost, den, čas nebo lokalitu.
            Dokud nebudou hodnoty sjednocené, nelze skupinu editovat.
        </div>
    }
}

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

@if (Model.Context.CanEdit)
{
    <form method="post">
        @if (Model.Context.IsGrouped)
        {
            <div class="training-edit-members">
                <table class="details">
                    <thead>
                        <tr>
                            <th>Kategorie</th>
                            <th>Trenér</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Context.Members.Count; i++)
                        {
                            var member = Model.Context.Members[i];
                            var memberLabelId = $"MemberCoachesLabel_{member.Id}";
                            <tr>
                                <td>@member.SeasonCategoryName</td>
                                <td>
                                    <input type="hidden"
                                           name="Input.MemberCoachAssignments[@i].TrainingPlanId"
                                           value="@member.Id" />
                                    <search-multiselect asp-for="Input.MemberCoachAssignments[i].CoachIds"
                                                         asp-items="Model.Context.AvailableCoachItems"
                                                         placeholder="Vyber trenéry..."
                                                         aria-labelledby="@memberLabelId" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @Html.EditorFor(
            model => model.Input,
            new { DayNameItems = Model.DayNameItems, LocationIdItems = Model.LocationIdItems })

        @if (!Model.Context.IsGrouped)
        {
            <div class="field">
                <span class="schedule-filter-label" id="CoachesLabel">Trenéři</span>
                <search-multiselect asp-for="Input.SelectedCoachIds"
                                     asp-items="Model.Context.AvailableCoachItems"
                                     placeholder="Vyber trenéry..."
                                     aria-labelledby="CoachesLabel" />
            </div>
        }

        <footer>
            <button type="submit" class="button">
                <i class="fa-solid fa-floppy-disk fa-fw"></i> Uložit
            </button>
            <button type="button" class="button secondary" onclick="closeTrainingPlanEdit()">
                <i class="fa-solid fa-xmark fa-fw"></i> Zavřít
            </button>
        </footer>
    </form>
}
else
{
    <p class="buttons">
        <button type="button" class="button secondary" onclick="closeTrainingPlanEdit()">
            <i class="fa-solid fa-xmark fa-fw"></i> Zavřít
        </button>
    </p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function closeTrainingPlanEdit() {
            window.close();
            window.setTimeout(function () {
                if (!window.closed) {
                    window.location.href = '@Url.Page("./Index")';
                }
            }, 100);
        }
    </script>
}
