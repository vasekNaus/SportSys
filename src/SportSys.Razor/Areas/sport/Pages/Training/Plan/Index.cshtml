@page
@model IndexModel
@{
    ViewData["Title"] = "Tréninkové plány";
    var selectedTrainingTypeNames = Model.TrainingTypes
        .Where(type => Model.SelectedTrainingTypeIds.Contains(type.Id))
        .Select(type => type.Name)
        .ToList();
    var trainingTypeSummary = selectedTrainingTypeNames.Count switch
    {
        0 => "Všechny typy",
        1 => selectedTrainingTypeNames[0],
        _ => $"Vybráno: {selectedTrainingTypeNames.Count}",
    };
    var locationSummary = Model.SelectedLocationIds.Count switch
    {
        0 => "Všechny lokality",
        1 => Model.Locations.FirstOrDefault(location => location.Id == Model.SelectedLocationIds[0])?.Name ?? "Vybráno: 1",
        _ => $"Vybráno: {Model.SelectedLocationIds.Count}",
    };
}

<form method="get" class="schedule-filter">
    <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
    <section class="schedule-filter-panel schedule-filter-panel--training">
        <h2 class="schedule-filter-panel-title">
            <i class="fa-solid fa-person-skating fa-fw"></i> Tréninky
        </h2>

        <div class="schedule-filter-row">
            <div class="field">
                <label for="SeasonId">Sezóna</label>
                <select id="SeasonId"
                        name="SeasonId"
                        class="textbox"
                        onchange="this.form.submit()">
                    <option value="">— vyberte sezónu —</option>
                    @foreach (var season in Model.Seasons)
                    {
                        <option value="@season.Id" selected="@(Model.SeasonId == season.Id)">
                            @season.Name
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <span class="schedule-filter-label" id="TrainingTypeLabel">Typ tréninku</span>
                <details class="schedule-multiselect"
                         data-multiselect
                         data-empty-label="Všechny typy">
                    <summary aria-labelledby="TrainingTypeLabel">
                        <span data-multiselect-summary>@trainingTypeSummary</span>
                    </summary>
                    <div class="schedule-multiselect-menu">
                        <div class="schedule-multiselect-options">
                            @foreach (var type in Model.TrainingTypes)
                            {
                                <label class="schedule-multiselect-option">
                                    <input type="checkbox"
                                           name="SelectedTrainingTypeIds"
                                           value="@type.Id"
                                           checked="@Model.SelectedTrainingTypeIds.Contains(type.Id)" />
                                    <span data-multiselect-option-label>@type.Name</span>
                                </label>
                            }
                        </div>
                        <button type="button"
                                class="schedule-multiselect-clear"
                                data-multiselect-clear
                                hidden>
                            <i class="fa-solid fa-filter-circle-xmark fa-fw"></i>
                            Vymazat výběr
                        </button>
                    </div>
                </details>
            </div>

            <div class="field">
                <span class="schedule-filter-label" id="LocationLabel">Lokalita</span>
                <details class="schedule-multiselect"
                         data-multiselect
                         data-empty-label="Všechny lokality">
                    <summary aria-labelledby="LocationLabel">
                        <span data-multiselect-summary>@locationSummary</span>
                    </summary>
                    <div class="schedule-multiselect-menu">
                        <div class="schedule-multiselect-options">
                            @foreach (var location in Model.Locations)
                            {
                                <label class="schedule-multiselect-option">
                                    <input type="checkbox"
                                           name="SelectedLocationIds"
                                           value="@location.Id"
                                           checked="@Model.SelectedLocationIds.Contains(location.Id)" />
                                    <span data-multiselect-option-label>@location.Name</span>
                                </label>
                            }
                        </div>
                        <button type="button"
                                class="schedule-multiselect-clear"
                                data-multiselect-clear
                                hidden>
                            <i class="fa-solid fa-filter-circle-xmark fa-fw"></i>
                            Vymazat výběr
                        </button>
                    </div>
                </details>
            </div>

            <div class="field">
                <label for="TrainingPhaseId">Fáze tréninku</label>
                <select id="TrainingPhaseId" name="TrainingPhaseId" class="textbox">
                    <option value="">— všechny fáze —</option>
                    @foreach (var phase in Model.TrainingPhases)
                    {
                        <option value="@phase.Id" selected="@(Model.TrainingPhaseId == phase.Id)">
                            @phase.Name
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="ValidOn">Datum platnosti</label>
                @Html.EditorFor(
                    m => m.ValidOn,
                    "Date",
                    new { InputCssClass = "textbox", InputOnChange = "this.form.submit()" })
                <span asp-validation-for="ValidOn" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label asp-for="SelectedCoachIds">Trenéři</label>
                <search-multiselect asp-for="SelectedCoachIds"
                                    asp-items="Model.CoachSelectList"
                                    placeholder="Hledat trenéra" />
            </div>
        </div>

        <fieldset class="schedule-filter-categories schedule-filter-categories--nested">
            <legend>Den</legend>
            <div class="schedule-filter-checkboxes">
                @foreach (var (day, label) in Model.WeekDayOptions)
                {
                    <label class="checkbox-label">
                        <input type="checkbox"
                               name="SelectedDaysOfWeek"
                               value="@day"
                               checked="@Model.SelectedDaysOfWeek.Contains(day)" />
                        @label
                    </label>
                }
            </div>
        </fieldset>

        @if (Model.SeasonCategories.Count > 0)
        {
            <fieldset class="schedule-filter-categories schedule-filter-categories--nested">
                <legend>Kategorie</legend>
                <div class="schedule-filter-checkboxes">
                    @foreach (var category in Model.SeasonCategories)
                    {
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   name="SelectedCategoryCodes"
                                   value="@category.Code"
                                   checked="@Model.SelectedCategoryCodes.Contains(category.Code)" />
                            @category.Code
                        </label>
                    }
                </div>
                <div class="schedule-filter-options">
                    <label class="checkbox-label">
                        <input type="checkbox" id="ShowEmptyRows" name="ShowEmptyRows" value="true" checked="@Model.ShowEmptyRows" />
                        <input type="hidden" name="ShowEmptyRows" value="false" />
                        Zobrazovat prázdné řádky
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" id="MergeTrainings" name="MergeTrainings" value="true"
                               checked="@Model.MergeTrainings"
                               onchange="this.form.submit()" />
                        <input type="hidden" name="MergeTrainings" value="false" />
                        Spojovat tréninky
                    </label>
                </div>
            </fieldset>
        }
        else if (Model.SeasonId.HasValue)
        {
            <p class="text-muted">Pro zvolenou sezónu nejsou definovány žádné aktivní kategorie.</p>
        }
    </section>

    <div class="schedule-filter-actions">
        <a asp-page="./Index" class="button secondary">
            <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtry
        </a>

        @if (Model.SeasonId.HasValue && Model.SeasonCategories.Count > 0)
        {
            <div class="schedule-filter-actions-primary">
                <button type="submit" class="button">
                    <i class="fa-solid fa-calendar-week fa-fw"></i> Zobrazit plán
                </button>
            </div>
        }
    </div>
</form>

@if (Model.ExportErrorMessage is not null)
{
    <p class="text-danger">@Model.ExportErrorMessage</p>
}

@if (Model.ScheduleView is not null)
{
    @if (!Model.ScheduleView.HasItems)
    {
        <p class="text-muted">Pro zadané parametry nebyly nalezeny žádné tréninkové plány.</p>
    }

    @await Component.InvokeAsync(
        "TrainingSchedule",
        new { model = Model.ScheduleView })

    @if (Model.PlanRows.Count > 0)
    {
        <partial name="_TrainingPlanTable" model="Model" />
    }

    @if (Model.CoverageRows.Count > 0)
    {
        <form method="get" asp-page="./Index" class="schedule-filter-actions">
            <input type="hidden" name="handler" value="ExportCoverage" />
            <input type="hidden" name="SeasonId" value="@Model.SeasonId" />
            @foreach (var code in Model.SelectedCategoryCodes)
            {
                <input type="hidden" name="SelectedCategoryCodes" value="@code" />
            }
            @foreach (var id in Model.SelectedTrainingTypeIds)
            {
                <input type="hidden" name="SelectedTrainingTypeIds" value="@id" />
            }
            @foreach (var id in Model.SelectedLocationIds)
            {
                <input type="hidden" name="SelectedLocationIds" value="@id" />
            }
            @foreach (var id in Model.SelectedCoachIds)
            {
                <input type="hidden" name="SelectedCoachIds" value="@id" />
            }
            <input type="hidden" name="TrainingPhaseId" value="@Model.TrainingPhaseId" />
            <input type="hidden" name="ValidOn" value="@Model.ValidOn?.ToString("yyyy-MM-dd")" />
            @foreach (var day in Model.SelectedDaysOfWeek)
            {
                <input type="hidden" name="SelectedDaysOfWeek" value="@day" />
            }
            <input type="hidden" name="ShowEmptyRows" value="@Model.ShowEmptyRows.ToString().ToLowerInvariant()" />
            <input type="hidden" name="MergeTrainings" value="@Model.MergeTrainings.ToString().ToLowerInvariant()" />
            <button type="submit" class="button secondary">Excel</button>
        </form>
    }

    @await Component.InvokeAsync(
        "TrainingRequirementCoverage",
        new
        {
            requirements = Model.CoverageRequirements,
            plans = Model.CoveragePlans,
            selectedCoachIds = Model.SelectedCoachIds,
        })

    @await Component.InvokeAsync(
        "TrainingPlanProblems",
        new { problems = Model.TrainingPlanProblems })
}
