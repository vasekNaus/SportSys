    <UserSecretsId>sportstys-consoleapp-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportSys.Contract\SportSys.Contract.csproj" />
    <ProjectReference Include="..\SportSys.Database\SportSys.Database.csproj" />
    <ProjectReference Include="..\SportSys.Model\SportSys.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
